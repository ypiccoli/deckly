# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" de verdade (já está no .gitignore).

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta em que o servidor HTTP/WebSocket vai escutar.
PORT=3000

# ---------------------------------------------------------------------------
# Acesso
# ---------------------------------------------------------------------------
# Token exigido para usar o deck. Deixe em branco: na primeira execução um é
# gerado e guardado em config/token.json, e aparece no terminal com um QR
# para parear o tablet. Preencha aqui só se quiser fixar um valor seu.
STREAM_DECK_TOKEN=

# A tela de configuração (e gravar o layout) por padrão só responde no
# próprio PC — um botão pode mandar abrir qualquer programa, então
# reconfigurar o deck vale tanto quanto executar código na máquina.
# Mude para "true" se quiser configurar pelo tablet também.
CONFIG_REMOTO=false

# ---------------------------------------------------------------------------
# Integração de mídia (volume e teclas de mídia do sistema)
# ---------------------------------------------------------------------------
# "auto"        -> detecta sozinho (WSL2 usa interop com o Windows; Windows nativo usa PowerShell direto)
# "wsl-windows" -> força o modo WSL2 -> Windows via powershell.exe/interop
# "windows"     -> força modo Windows nativo (quando o servidor roda direto no Windows)
MEDIA_BACKEND=auto

# ---------------------------------------------------------------------------
# OBS Studio (obs-websocket v5 — Ferramentas > WebSocket Server Settings)
# ---------------------------------------------------------------------------
OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=

# ---------------------------------------------------------------------------
# Spotify — veja "Habilitar o Spotify" no README para o passo a passo
# completo (criar o app, cadastrar o Redirect URI, autorizar em /spotify/login).
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Philips Hue (ainda não conectado — estrutura pronta para quando você quiser habilitar)
# HUE_BRIDGE_IP: IP local da bridge. HUE_APPLICATION_KEY: gerada apertando o botão físico da bridge.
# ---------------------------------------------------------------------------
HUE_BRIDGE_IP=
HUE_APPLICATION_KEY=

# Abrir a tela de boas-vindas no navegador ao iniciar:
#   "primeira" (padrão) -> só na primeira execução, quando o token é gerado
#   "sempre"            -> toda vez que o servidor sobe
#   "nunca"             -> nunca
ABRIR_NAVEGADOR=primeira

# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" de verdade (já está no .gitignore).

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta em que o servidor HTTP/WebSocket vai escutar.
PORT=3000

# ---------------------------------------------------------------------------
# Acesso
# ---------------------------------------------------------------------------
# Token exigido para usar o deck. Deixe em branco: na primeira execução um é
# gerado e guardado em config/token.json, e aparece no terminal com um QR
# para parear o tablet. Preencha aqui só se quiser fixar um valor seu.
STREAM_DECK_TOKEN=

# A tela de configuração (e gravar o layout) por padrão só responde no
# próprio PC — um botão pode mandar abrir qualquer programa, então
# reconfigurar o deck vale tanto quanto executar código na máquina.
# Mude para "true" se quiser configurar pelo tablet também.
CONFIG_REMOTO=false

# ---------------------------------------------------------------------------
# Integração de mídia (volume e teclas de mídia do sistema)
# ---------------------------------------------------------------------------
# "auto"        -> detecta sozinho (WSL2 usa interop com o Windows; Windows nativo usa PowerShell direto)
# "wsl-windows" -> força o modo WSL2 -> Windows via powershell.exe/interop
# "windows"     -> força modo Windows nativo (quando o servidor roda direto no Windows)
MEDIA_BACKEND=auto

# ---------------------------------------------------------------------------
# OBS Studio (obs-websocket v5 — Ferramentas > WebSocket Server Settings)
# ---------------------------------------------------------------------------
# Deixe "true" mesmo sem o OBS aberto: o servidor tenta conectar de tempos em
# tempos, em silêncio, e liga sozinho assim que você abrir o OBS. Ponha
# "false" se você não usa OBS e quer o módulo desligado de vez.
OBS_HABILITADO=true

OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=

# ---------------------------------------------------------------------------
# Spotify
# ---------------------------------------------------------------------------
# Não precisa preencher nada aqui à mão: abra a tela de configuração
# (http://127.0.0.1:3000/config/#integracoes), cole o Client ID e o Client
# Secret e clique em "Conectar ao Spotify". O refresh token é obtido e
# gravado sozinho.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Em branco, vira http://127.0.0.1:<PORT>/spotify/callback — que é o que a
# tela de configuração manda cadastrar no painel do Spotify. Só preencha se
# precisar de um endereço diferente, e cadastre o mesmo valor lá.
SPOTIFY_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Funciona por atalho GLOBAL de teclado, não pela API do Discord (o acesso
# ao RPC dele exige aprovação caso a caso). Cadastre as mesmas combinações em
# Configurações do Usuário > Teclas de Atalho, no Discord — elas não vêm
# configuradas de fábrica. Em branco, valem os padrões sugeridos abaixo.
DISCORD_TECLA_MUDO=
DISCORD_TECLA_SURDO=
DISCORD_TECLA_VIDEO=

# ---------------------------------------------------------------------------
# Philips Hue (ainda não conectado — estrutura pronta para quando você quiser habilitar)
# HUE_BRIDGE_IP: IP local da bridge. HUE_APPLICATION_KEY: gerada apertando o botão físico da bridge.
# ---------------------------------------------------------------------------
HUE_BRIDGE_IP=
HUE_APPLICATION_KEY=

# ---------------------------------------------------------------------------
# Comportamento do executável (.exe)
# ---------------------------------------------------------------------------
# Rodar em segundo plano: o programa se solta da janela do cmd, então dá para
# fechá-la sem derrubar o deck. Para encerrar, use o botão "Encerrar servidor"
# na tela de boas-vindas. Só vale para o .exe (rodando por npm start o console
# continua sendo o lugar certo dos logs).
#   "true" (padrão) -> solta da janela; os logs vão para dados/stream-deck.log
#   "false"         -> fica preso à janela, com os logs na tela
# Também dá para forçar o modo com janela executando: stream-deck-web.exe --console
SEGUNDO_PLANO=true

# Abrir a tela de boas-vindas no navegador ao iniciar:
#   "primeira" (padrão) -> só na primeira execução, quando o token é gerado
#   "sempre"            -> toda vez que o servidor sobe
#   "nunca"             -> nunca
ABRIR_NAVEGADOR=primeira

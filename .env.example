# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" de verdade (já está no .gitignore).

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta em que o servidor HTTP/WebSocket vai escutar.
PORT=3000

# ---------------------------------------------------------------------------
# Acesso
# ---------------------------------------------------------------------------
# Token exigido para usar o deck. Deixe em branco: na primeira execução um é
# gerado e guardado em config/token.json, e aparece no terminal com um QR
# para parear o tablet. Preencha aqui só se quiser fixar um valor seu.
DECKLY_TOKEN=

# A tela de configuração (e gravar o layout) por padrão só responde no
# próprio PC — um botão pode mandar abrir qualquer programa, então
# reconfigurar o deck vale tanto quanto executar código na máquina.
# Mude para "true" se quiser configurar pelo tablet também.
CONFIG_REMOTO=false

# ---------------------------------------------------------------------------
# Integração de mídia (volume e teclas de mídia do sistema)
# ---------------------------------------------------------------------------
# "auto"        -> detecta sozinho (WSL2 usa interop com o Windows; Windows nativo usa PowerShell direto)
# "wsl-windows" -> força o modo WSL2 -> Windows via powershell.exe/interop
# "windows"     -> força modo Windows nativo (quando o servidor roda direto no Windows)
MEDIA_BACKEND=auto

# ---------------------------------------------------------------------------
# OBS Studio (obs-websocket v5 — Ferramentas > WebSocket Server Settings)
# ---------------------------------------------------------------------------
# Deixe "true" mesmo sem o OBS aberto: o servidor tenta conectar de tempos em
# tempos, em silêncio, e liga sozinho assim que você abrir o OBS. Ponha
# "false" se você não usa OBS e quer o módulo desligado de vez.
OBS_HABILITADO=true

OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=

# ---------------------------------------------------------------------------
# Spotify
# ---------------------------------------------------------------------------
# Não precisa preencher nada aqui à mão: abra a tela de configuração
# (http://127.0.0.1:3000/config/#integracoes), cole o Client ID e o Client
# Secret e clique em "Conectar ao Spotify". O refresh token é obtido e
# gravado sozinho.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Em branco, vira http://127.0.0.1:<PORT>/spotify/callback — que é o que a
# tela de configuração manda cadastrar no painel do Spotify. Só preencha se
# precisar de um endereço diferente, e cadastre o mesmo valor lá.
SPOTIFY_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Dois modos, que resolvem problemas diferentes:
#
#   teclado (padrão) — simula os atalhos do Discord. Funciona para qualquer
#     pessoa, sem cadastro nenhum, mas é cego: os botões não acendem, porque
#     o Discord não conta se você está mudo.
#
#   rpc — fala com o Discord pelo canal local. Os botões acendem, os canais
#     de voz são listados de verdade e trocar de canal não depende de foco.
#     Exige criar um app em discord.com/developers/applications; o escopo
#     `rpc` só vale para o dono do app e para quem ele cadastrar como
#     testador, então serve para o seu deck, não para distribuir.
DISCORD_MODO=teclado

# Só no modo rpc. Client ID e Secret saem de OAuth2, no app que você criou.
# Os dois tokens são gravados sozinhos ao clicar "Conectar ao Discord" na aba
# Integrações — não precisa preencher à mão. O access token do Discord vale 7
# dias; o refresh token é o que compra um novo sem pedir sua aprovação de
# novo toda semana, e ele muda a cada renovação.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ACCESS_TOKEN=
DISCORD_REFRESH_TOKEN=

# Só no modo rpc. Nomes que o botão de AFK aceita como "canal de ausentes",
# separados por vírgula. Em branco valem: afk, ausente, ausentes, away,
# inativo, inativos. A comparação ignora acento, caixa e emoji, então
# "🔇 AUSENTES 🔇" casa com "ausentes". O RPC não informa qual é o canal AFK
# oficial da guild, por isso a busca é pelo nome.
DISCORD_NOMES_AFK=

# Daqui para baixo, só o modo teclado usa.
# Usa os atalhos que JÁ VÊM no Discord (Configurações > Atalhos de teclado —
# lista só de leitura). Eles só funcionam com o Discord em foco, por isso
# cada ação traz ele para frente antes. Se você criar atalhos GLOBAIS
# próprios em Configurações > Teclas de Atalho, informe-os aqui e ponha
# DISCORD_FOCAR_ANTES=false para não perder o foco do que estiver aberto.
# Em branco, valem os padrões do Discord:
#   mudo CTRL+SHIFT+M · surdo CTRL+SHIFT+D · atender CTRL+ENTER
#   recusar ESC · painel de som CTRL+SHIFT+B · busca CTRL+K
#   canal ALT+UP/DOWN · servidor CTRL+ALT+UP/DOWN
#   ligação atual CTRL+SHIFT+ALT+V
DISCORD_FOCAR_ANTES=true

# Nomes de canais/servidores para o seletor "Ir para…", separados por
# vírgula. Ex.: Geral, Bate-papo, Estudos
DISCORD_DESTINOS=

DISCORD_TECLA_MUDO=
DISCORD_TECLA_SURDO=
DISCORD_TECLA_ATENDER=
DISCORD_TECLA_RECUSAR=
DISCORD_TECLA_PAINEL_SOM=
DISCORD_TECLA_CANAL_ANTERIOR=
DISCORD_TECLA_CANAL_PROXIMO=
DISCORD_TECLA_SERVIDOR_ANTERIOR=
DISCORD_TECLA_SERVIDOR_PROXIMO=
DISCORD_TECLA_LIGACAO_ATUAL=
DISCORD_TECLA_BUSCA=

# ---------------------------------------------------------------------------
# Home Assistant (casa inteligente: luzes, tomadas e cenas de qualquer marca)
# ---------------------------------------------------------------------------
# Não precisa preencher à mão: a aba Integrações grava os dois. O endereço é o
# mesmo que você usa no navegador, com http:// e a porta — use o IP da rede
# local, não o endereço da Nabu Casa.
HOME_ASSISTANT_URL=

# Token de acesso de longa duração: no Home Assistant, clique no seu usuário
# (canto inferior esquerdo), aba Segurança, role até o fim e crie um. Ele só
# aparece uma vez.
HOME_ASSISTANT_TOKEN=

# ---------------------------------------------------------------------------
# Comportamento do executável (.exe)
# ---------------------------------------------------------------------------
# Rodar em segundo plano: o programa se solta da janela do cmd, então dá para
# fechá-la sem derrubar o deck. Para encerrar, use o botão "Encerrar servidor"
# na tela de boas-vindas. Só vale para o .exe (rodando por npm start o console
# continua sendo o lugar certo dos logs).
#   "true" (padrão) -> solta da janela; os logs vão para dados/deckly.log
#   "false"         -> fica preso à janela, com os logs na tela
# Também dá para forçar o modo com janela executando: deckly.exe --console
SEGUNDO_PLANO=true

# Abrir a tela de boas-vindas no navegador ao iniciar:
#   "primeira" (padrão) -> só na primeira execução, quando o token é gerado
#   "sempre"            -> toda vez que o servidor sobe
#   "nunca"             -> nunca
ABRIR_NAVEGADOR=primeira
